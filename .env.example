# Copy to .env; never commit the local file.
CRAFTY_IMAGE=arcadiatechnology/crafty-4:4.11.0@sha256:7b6e87514259549647e15ceeaf73d238792e6d77e2c79fc744d5badc8d6e997c
CRAFTY_PORT=8443
CRAFTY_MEMORY_LIMIT=4g
# Panel-only deployment is the safe initial default.
COMPOSE_FILE=compose.yaml
# After resolving conflicts: COMPOSE_FILE=compose.yaml:compose.gameplay.yaml
# Keep FAMILY_BIND loopback until every authentication test passes.
VANILLA_BIND=127.0.0.1
FAMILY_BIND=127.0.0.1
FORGE_BIND=127.0.0.1
VANILLA_PORT=25565
FAMILY_PORT=25566
FORGE_PORT=25567
